# Local / generated — do not commit PHI dumps or run outputs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Training OCR / workbook dumps often contain PHI — keep local
data/raw/

# Run outputs
reports/*.csv
reports/*.xlsx
reports/inference*
reports/*_eval.json
reports/model_comparison.json
reports/dataset_quality*

# Optional embedding artifacts
models/embedding_flat.joblib
models/*.tmp

# BERT weights are tracked with Git LFS (see repo .gitattributes); the repo root ignores *.safetensors.
# Synthetic prompts / checked output are regenerable; the combined file duplicates synthetic/raw.
!models/bert_page/model.safetensors
models/bert_page.tmp/
synthetic/raw/
synthetic/prompts/
synthetic/checked/*
!synthetic/checked/clean.jsonl
synthetic/synthetic_all_*.jsonl
